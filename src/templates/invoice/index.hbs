{{#> layout title=(concat 'document.' type ) documentNumber=documentNumber}}
    <div class="document invoice">
        {{> header 
            type=type 
            subType=subType
            isCreditOrDebit=isCreditOrDebit
            documentType=documentType 
            documentNumber=documentNumber
            date=date
            dueDate=dueDate
            relatedDocument=relatedDocument
            subType=subType
        }}
        {{> company-details 
            type='invoice' 
            recipient=recipient 
            supplier=supplier
        }}
        {{> items-table 
            type='invoice'
            items=items
            totals=totals
            currency=currency
        }}
        {{> transaction-details 
            type='invoice'
            transaction=transaction
            payment=payment
        }}
        {{> signatures 
            type='invoice' 
            recipient=recipient 
            supplier=supplier
        }}
    </div>
    {{#if vatResponse}}
        {{> vat-response vatResponse=vatResponse}}
    {{/if}}
{{/layout}} 