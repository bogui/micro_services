<div class="company-details">
    {{> components/company-info company=companyDetails}}
</div>

<div class='document-info'>
  <h1 class='text-invoice-title text-primary mb-2'>{{t documentType}}</h1>
  <p class='text-invoice-subtitle text-gray-900 mb-1'>#{{documentNumber}}</p>
  <p class='text-gray-600'>
    {{t 'invoice.date'}}:
    {{formatDate date 'short'}}<br />
    {{#if dueDate}}
        {{t 'invoice.dueDate'}}: {{formatDate dueDate 'short'}}
    {{/if}}
  </p>
</div>
