{{#if (and inWords (eq locale 'bg'))}}
  <div class="py-4">
    <p><strong>{{t 'inWords'}}:</strong> {{inWords}}</p>
  </div>
{{/if}}
<div class='flex mb-8'>
  {{#if transaction}}
    <div class='w-2/3'>
      <table class='w-full'>
        <tr>
          <th class='text-left'>{{t 'document.transaction.taxEventDate'}}</th>
          <td>{{formatDate transaction.taxEventDate 'short'}}</td>
        </tr>
        <tr>
          <th class='text-left'>{{t 'document.transaction.basis'}}</th>
          <td>{{transaction.basis}}</td>
        </tr>
        <tr>
          <th class='text-left'>{{t 'document.transaction.description'}}</th>
          <td>{{transaction.description}}</td>
        </tr>
        <tr>
          <th class='text-left'>{{t 'document.transaction.location'}}</th>
          <td>{{transaction.location}}</td>
        </tr>
      </table>
    </div>
  {{/if}}

  {{#if payment}}
    <div class='w-1/3'>
      <table class='w-full'>
        <tr>
          <th class='text-left'>{{t 'document.payment.method'}}:</th>
          <td>{{t (concat 'document.payment.' payment.method)}}</td>
        </tr>
        <tr>
          <td colspan='2'>&nbsp;</td>
        </tr>
        {{#if payment.banks.length}}
        {{#each payment.banks as |bank index|}}
            <tr>
              <th class='text-left'>{{t 'document.payment.bank'}}:</th>
              <td>{{bank.name}}</td>
            </tr>
            <tr>
              <th class='text-left'>{{t 'document.payment.iban'}}:</th>
              <td>{{bank.iban}}</td>
            </tr>
            <tr>
              <th class='text-left'>{{t 'document.payment.bic'}}:</th>
              <td>{{bank.bic}}</td>
            </tr>
            {{#unless (eq index (subtract ../payment.banks.length 1))}}
              <tr>
                <td colspan='2'>&nbsp;</td>
              </tr>
            {{/unless}}
          {{/each}}
        {{/if}}
      </table>
    </div>
  {{/if}}
</div>