<div class='text-center mb-8'>
  <h1 class='text-2xl mb-2'>{{t (concat 'document.' type)}}</h1>
  {{#if (eq type 'invoice')}}
    <h3 class='text-lg'>{{t (concat 'document.' subType)}}</h3>
  {{/if}}
</div>

<div class='flex justify-end mb-6'>
  <table>
    <tr>
      <td class='min-w-32'>{{t 'document.number'}}:</td>
      <td>{{documentNumber}}</td>
    </tr>
    <tr>
      <td>{{t 'document.date'}}:</td>
      <td>{{formatDate date 'short'}}</td>
    </tr>
    {{#if (and (eq type 'invoice') dueDate)}}
      <tr>
        <td>{{t 'document.dueDate'}}:</td>
        <td>{{formatDate dueDate 'short'}}</td>
      </tr>
    {{/if}}
    {{#if isCreditOrDebit}}
      <tr>
        <td colspan='2'>&nbsp;</td>
      </tr>
      <tr>
        <td>{{t 'document.relatedDocument.title'}}:</td>
        <td>{{relatedDocument.documentNumber}}</td>
      </tr>
      <tr>
        <td>{{t 'document.relatedDocument.date'}}:</td>
        <td>{{formatDate relatedDocument.date 'short'}}</td>
      </tr>
    {{/if}}
  </table>
</div>