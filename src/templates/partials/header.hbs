<div class='text-center mb-8'>
  <h1 class='text-2xl mb-2'>{{t (concat type '.title')}}</h1>
  <h3 class='text-lg'>{{t (concat type '.original')}}</h3>
</div>

<div class='flex justify-between mb-6'>
  <div class='self-end'>
    <p>{{t (concat type '.number')}}:
      <span class='font-bold'>{{documentNumber}}</span></p>
  </div>
  <table>
    <tr>
      <td>{{t (concat type '.date')}}:</td>
      <td>{{formatDate date 'short'}}</td>
    </tr>
    {{#if (eq type 'invoice')}}
      <tr>
        <td>{{t (concat type '.dueDate')}}:</td>
        <td>{{formatDate dueDate 'short'}}</td>
      </tr>
    {{/if}}
  </table>
</div>