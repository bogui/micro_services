<div class='grid grid-cols-2 mb-12'>
  <div class='border border-e-0 p-4'>
    <table class='w-full'>
      <tr>
        <th class='text-left'>{{t 'document.recipient.title'}}</th>
        <td>{{recipient.name}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.recipient.vat'}}</th>
        <td>{{recipient.vatNumber}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.recipient.id'}}</th>
        <td>{{recipient.identNumber}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.recipient.city'}}</th>
        <td>{{recipient.city}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.recipient.address'}}</th>
        <td>{{recipient.address}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.recipient.representative'}}</th>
        <td>{{recipient.representative}}</td>
      </tr>
    </table>
  </div>
  <div class='border p-4'>
    <table class='w-full'>
      <tr>
        <th class='text-left'>{{t 'document.supplier.title'}}</th>
        <td>{{supplier.name}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.supplier.vat'}}</th>
        <td>{{supplier.vatNumber}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.supplier.id'}}</th>
        <td>{{supplier.identNumber}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.supplier.city'}}</th>
        <td>{{supplier.city}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.supplier.address'}}</th>
        <td>{{supplier.address}}</td>
      </tr>
      <tr>
        <th class='text-left'>{{t 'document.supplier.representative'}}</th>
        <td>{{supplier.representative}}</td>
      </tr>
    </table>
  </div>
</div>