{{#> base/layout 
    title=(concat "Custom Invoice " documentNumber)
    documentType="CUSTOM INVOICE"
    styles=styles
}}
    {{#*inline "content"}}
        <!-- Custom Header with Logo Placeholder -->
        <div class="custom-header mb-8 text-center">
            <div class="logo-placeholder bg-gray-100 w-32 h-32 mx-auto mb-4 flex items-center justify-center rounded-full">
                <span class="text-gray-400">Logo</span>
            </div>
            <h2 class="text-2xl text-primary font-bold">{{uppercase companyDetails.name}}</h2>
        </div>

        <!-- Client Information in a Card -->
        <div class="client-card bg-gray-50 p-6 rounded-lg shadow-xs mb-8">
            <h3 class="text-lg text-primary font-semibold mb-4">Client Information</h3>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-gray-600">Name</p>
                    <p class="font-semibold">{{clientDetails.name}}</p>
                </div>
                <div>
                    <p class="text-gray-600">Email</p>
                    <p class="font-semibold">{{clientDetails.email}}</p>
                </div>
                <div class="col-span-2">
                    <p class="text-gray-600">Address</p>
                    <p class="font-semibold">{{clientDetails.address}}</p>
                </div>
            </div>
        </div>

        <!-- Invoice Details -->
        <div class="invoice-details mb-6">
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <p class="text-gray-600">Invoice Number</p>
                    <p class="font-semibold">#{{documentNumber}}</p>
                </div>
                <div>
                    <p class="text-gray-600">Date Issued</p>
                    <p class="font-semibold">{{formatDate date 'long'}}</p>
                </div>
                <div>
                    <p class="text-gray-600">Due Date</p>
                    <p class="font-semibold">{{formatDate dueDate 'long'}}</p>
                </div>
            </div>
        </div>

        <!-- Items Table with Modern Design -->
        <div class="items-table-wrapper overflow-hidden rounded-lg border border-gray-200 mb-8">
            <table class="w-full">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="w-[40%] p-4 text-left text-primary font-semibold">Description</th>
                        <th class="w-[20%] p-4 text-center text-primary font-semibold">Quantity</th>
                        <th class="w-[20%] p-4 text-right text-primary font-semibold">Unit Price</th>
                        <th class="w-[20%] p-4 text-right text-primary font-semibold">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each items}}
                    <tr class="border-t border-gray-200">
                        <td class="p-4">
                            <p class="font-medium">{{description}}</p>
                        </td>
                        <td class="p-4 text-center">{{quantity}}</td>
                        <td class="p-4 text-right">{{format unitPrice}}</td>
                        <td class="p-4 text-right">{{format total}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <!-- Totals with Modern Design -->
        <div class="totals-modern float-right w-[300px] bg-gray-50 p-4 rounded-lg">
            <div class="flex justify-between py-2">
                <span class="text-gray-600">Subtotal</span>
                <span class="font-medium">{{format subtotal}}</span>
            </div>
            <div class="flex justify-between py-2">
                <span class="text-gray-600">Tax ({{math 'multiply' (math 'divide' tax subtotal) 100}}%)</span>
                <span class="font-medium">{{format tax}}</span>
            </div>
            <div class="flex justify-between py-3 mt-2 border-t-2 border-primary">
                <span class="text-lg font-bold text-primary">Total</span>
                <span class="text-lg font-bold text-primary">{{format total}}</span>
            </div>
        </div>

        <!-- Footer with Payment Terms -->
        <div class="footer clear-both pt-16">
            <div class="payment-terms bg-gray-50 p-4 rounded-lg">
                <h4 class="text-primary font-semibold mb-2">Payment Terms</h4>
                <p class="text-gray-600 text-sm">Please make payment within {{when dueDate '30'}} days.</p>
                <p class="text-gray-600 text-sm">Thank you for your business!</p>
            </div>
        </div>
    {{/inline}}
{{/base/layout}} 