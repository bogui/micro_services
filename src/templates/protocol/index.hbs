{{#> layout title=(concat 'document.' type ) documentNumber=documentNumber}}
    <div class="document protocol">
        {{> header 
            type='protocol' 
            documentNumber=documentNumber
            date=date
        }}
        {{> company-details 
            type='protocol' 
            recipient=recipient 
            supplier=supplier
        }}
        {{> items-table 
            type='protocol'
            items=items
            totals=totals
            currency=currency
            locale=locale
        }}
        {{> signatures 
            type='protocol' 
            recipient=recipient 
            supplier=supplier
        }}
    </div>
{{/layout}} 