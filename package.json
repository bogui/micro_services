{
  "name": "pdf-service",
  "version": "2.0.0",
  "description": "PDF Generation Service for invoices",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon",
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "test": "node --no-deprecation ./node_modules/.bin/jest",
    "test:watch": "node --no-deprecation ./node_modules/.bin/jest --watch",
    "test:coverage": "node --no-deprecation ./node_modules/.bin/jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "pdf",
    "invoice",
    "puppeteer"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "ioredis": "^5.3.2",
    "puppeteer": "^24.2.1",
    "redis": "^4.6.13",
    "typescript": "^5.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  }
}
