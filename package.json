{
  "name": "pdf-service",
  "version": "1.6.1",
  "description": "PDF Generation Service for invoices",
  "main": "dist/index.js",
  "scripts": {
    "setup:dev": "chmod +x ./scripts/setup-dev.sh && ./scripts/setup-dev.sh",
    "start": "node dist/index.js",
    "dev": ". .venv/bin/activate && concurrently \"npm run watch\" \"npm run watch:css\" \"nodemon\"",
    "dev:templates": "concurrently \"NODE_ENV=development nodemon --watch 'src/**/*.ts' --ignore 'src/**/*.spec.ts' --exec 'ts-node' src/dev-server.ts\" \"npm run watch:css\"",
    "build": "npm run build:css && tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "test": "node --no-deprecation ./node_modules/.bin/jest",
    "test:watch": "node --no-deprecation ./node_modules/.bin/jest --watch",
    "test:coverage": "node --no-deprecation ./node_modules/.bin/jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "build:css": "npx @tailwindcss/cli -i ./src/templates/styles/main.css -o ./dist/templates/styles/main.css",
    "watch:css": "npx @tailwindcss/cli -i ./src/templates/styles/main.css -o ./dist/templates/styles/main.css --watch"
  },
  "keywords": [
    "pdf",
    "invoice",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.2",
    "redis": "^4.6.13",
    "typescript": "^5.4.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.6",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/chokidar": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "autoprefixer": "^10.4.18",
    "chokidar": "^4.0.3",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "express": "^4.21.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.0",
    "playwright": "^1.50.0",
    "postcss": "^8.5.3",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ws": "^8.18.0"
  }
}
