{
  "name": "pdf-service",
  "version": "2.0.0",
  "description": "PDF Generation Service for invoices",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon",
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "test": "node --no-deprecation ./node_modules/.bin/jest",
    "test:watch": "node --no-deprecation ./node_modules/.bin/jest --watch",
    "test:coverage": "node --no-deprecation ./node_modules/.bin/jest --coverage"
  },
  "keywords": [
    "pdf",
    "invoice",
    "puppeteer"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "ioredis": "^5.3.2",
    "puppeteer": "^24.2.1",
    "redis": "^4.6.13",
    "typescript": "^5.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  }
}
